{
  "__inputs": [
    {
      "name": "DS_AZURE_MONITOR",
      "label": "Azure Monitor",
      "type": "datasource",
      "pluginId": "grafana-azure-monitor-datasource",
      "pluginName": "Azure Monitor"
    }
  ],
  "id": null,
  "uid": "platform-application",
  "title": "Platform application",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "workspace",
        "type": "constant",
        "label": "Log Analytics workspace resource ID",
        "query": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-platform-interview/providers/Microsoft.OperationalInsights/workspaces/law-platform",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Average request duration",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "query": "AppRequests\n| where $__timeFilter(TimeGenerated)\n| summarize AverageDuration = avg(DurationMs) by bin(TimeGenerated, 5m)\n| order by TimeGenerated asc",
            "resultFormat": "time_series",
            "resources": [
              "${workspace}"
            ]
          }
        }
      ]
    }
  ]
}
